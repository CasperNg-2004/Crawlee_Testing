# Search phrase and area can be changed independently.
QUERY=restaurants
# Optional: run separate searches and combine/deduplicate their results.
# Separate search phrases with |. When set, this takes precedence over QUERY.
# QUERIES=cafes|drinks
AREA=Kuala Lumpur, Malaysia
MAX_PLACES=1000
MAX_CANDIDATES_PER_AREA=150

# Optional: search several smaller areas to get more coverage. Separate areas with |.
# When AREAS is set, it takes precedence over AREA. Results are deduplicated.
AREAS=Kuala Lumpur City Centre|Bukit Bintang, Kuala Lumpur|Bangsar, Kuala Lumpur|Mont Kiara, Kuala Lumpur|Chow Kit, Kuala Lumpur|Brickfields, Kuala Lumpur|Cheras, Kuala Lumpur|Setapak, Kuala Lumpur|Titiwangsa, Kuala Lumpur|Kepong, Kuala Lumpur|Sri Petaling, Kuala Lumpur|Desa ParkCity, Kuala Lumpur

# Maps loads results gradually. Increase these if your connection is slow.
MAX_STALLED_SCROLLS=12
SCROLL_WAIT_MS=2000

# Keep visible for the complete Google Maps interface, including structured Menu tabs.
HEADLESS=false

# Created and opened by `npm run login`. Contains sensitive Google session data; never share it.
CHROME_PROFILE_DIR=.chrome-profile
# Optional when Chrome is installed in a non-standard location.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Restart Chrome after this many restaurant-detail requests in safe mode.
SAFE_BATCH_SIZE=4
# Give Windows time to release the dedicated Chrome profile between batches.
SAFE_RESTART_DELAY_MS=5000
# Stop safely instead of looping forever if Chrome repeatedly fails to launch.
SAFE_MAX_CONSECUTIVE_FAILURES=3
