# Copy this file to .env, then adjust the values marked as commonly changed.

# ============================================================
# 1. SEARCH TARGETS - CHANGE THESE FOR A NEW SCRAPE
# ============================================================

# Fallback search phrase. QUERIES below takes priority when it is not empty.
QUERY=cafes

# Search multiple business types. Separate each phrase with |.
QUERIES=cafes|drink

# Fallback location. AREAS below takes priority when it is not empty.
AREA=Kuala Lumpur, Malaysia

# Search multiple areas. Separate each area with |.
# Results found across different searches are deduplicated.
AREAS=Kuala Lumpur City Centre|Bukit Bintang, Kuala Lumpur|Bangsar, Kuala Lumpur|Mont Kiara, Kuala Lumpur|Chow Kit, Kuala Lumpur|Brickfields, Kuala Lumpur|Cheras, Kuala Lumpur|Setapak, Kuala Lumpur|Titiwangsa, Kuala Lumpur|Kepong, Kuala Lumpur|Sri Petaling, Kuala Lumpur|Desa ParkCity, Kuala Lumpur


# ============================================================
# 2. RESULT LIMITS - COMMONLY ADJUSTED
# ============================================================

# Maximum total number of unique locations saved across all queries and areas.
MAX_PLACES=50

# Maximum candidates collected from each query-and-area search.
MAX_CANDIDATES_PER_AREA=150


# ============================================================
# 3. SEARCH PAGE LOADING AND SCROLLING
# ============================================================

# Stop a search after this many scrolls produce no new locations.
MAX_STALLED_SCROLLS=12

# Wait after each search-results scroll, in milliseconds.
# Increase this for a slow connection; decreasing it may miss locations.
SCROLL_WAIT_MS=2000


# ============================================================
# 4. PHOTO COLLECTION
# ============================================================

# Set to false to skip photos and substantially reduce runtime and memory use.
SCRAPE_PHOTOS=true

# Maximum photos saved for each location.
PHOTO_MAX_PER_PLACE=30

# Google Maps photo tabs to check. Separate tab names with |.
PHOTO_TABS=All|Menu|By owner

# Upload-date collection is slow and memory-heavy. Keep false unless required.
PHOTO_CAPTURE_UPLOAD_DATE=false


# ============================================================
# 5. MALAYSIA BRAND-SIZE CLASSIFICATION
# ============================================================

# Contains verified Malaysia outlet counts used for brandSize and numberOfOutlets.
CHAIN_CLASSIFICATION_CATALOG=config/malaysia-chain-counts.json


# ============================================================
# 6. CHROME AND DISPLAY
# ============================================================

# Keep false for the full visible Google Maps interface and reliable Menu tabs.
HEADLESS=false

# Dedicated Chrome profile created by npm run login. Never share this folder.
CHROME_PROFILE_DIR=.chrome-profile

# Uncomment only if Chrome is installed in a non-standard location.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe


# ============================================================
# 7. SAFE-RUN MEMORY AND RESTART SETTINGS
# ============================================================

# Locations processed before Chrome is restarted to release memory.
# Smaller batches use less memory but add more restart overhead.
SAFE_BATCH_SIZE=4

# Wait between Chrome batches, in milliseconds, to release the profile lock.
SAFE_RESTART_DELAY_MS=5000

# Stop after this many consecutive failures while preserving completed work.
SAFE_MAX_CONSECUTIVE_FAILURES=3


# ============================================================
# 8. WINDOWS COMPATIBILITY - NORMALLY DO NOT CHANGE
# ============================================================

# Crawlee system monitoring and terminal width settings used by the crash fix.
CRAWLEE_SYSTEM_INFO_V2=true
COLUMNS=200


# ============================================================
# 9. INDEPENDENT PHOTO ANALYSIS - DOES NOT CHANGE THE SCRAPER
# ============================================================

# Leave empty to analyze every restaurant with photos in the input JSON.
# Set a positive number only when running a smaller test.
PHOTO_ANALYSIS_PLACE_LIMIT=

# Analyze no more than this many existing photos per restaurant.
PHOTO_ANALYSIS_MAX_PHOTOS_PER_PLACE=30

# CPU and q8 are the stable low-memory defaults for a 12 GB RAM / 4 GB VRAM PC.
PHOTO_ANALYSIS_MODEL=Xenova/clip-vit-base-patch32
PHOTO_ANALYSIS_DTYPE=q8
PHOTO_ANALYSIS_DEVICE=cpu

# OCR languages: English and Malay. Separate extra languages with +.
PHOTO_ANALYSIS_OCR_LANGUAGES=eng+msa
PHOTO_ANALYSIS_OCR_CACHE=.cache/tesseract

# Resized inference image; the original full-size URL is preserved in output.
PHOTO_ANALYSIS_IMAGE_SIZE=1280
PHOTO_ANALYSIS_DELAY_MS=250

# Low model score or a narrow first-versus-second margin becomes unknown.
PHOTO_ANALYSIS_MIN_SCORE=0.42
PHOTO_ANALYSIS_MIN_MARGIN=0.08

# Manual labels make precision/recall measurable rather than guessed.
PHOTO_ANALYSIS_LABELS=config/photo-analysis-labels.csv

# Local manual labelling interface. It opens in your default browser.
PHOTO_LABEL_PORT=3789
PHOTO_LABEL_OPEN_BROWSER=true

# Leave empty to label the newest completed photo-analysis run.
PHOTO_LABEL_INPUT=
