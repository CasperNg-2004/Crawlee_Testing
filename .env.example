# Search phrase and area can be changed independently.
QUERY=restaurants
AREA=Kuala Lumpur, Malaysia
MAX_PLACES=1000

# Optional: search several smaller areas to get more coverage. Separate areas with |.
# When AREAS is set, it takes precedence over AREA. Results are deduplicated.
AREAS=Kuala Lumpur City Centre|Bukit Bintang, Kuala Lumpur|Bangsar, Kuala Lumpur|Mont Kiara, Kuala Lumpur|Chow Kit, Kuala Lumpur|Brickfields, Kuala Lumpur|Cheras, Kuala Lumpur|Setapak, Kuala Lumpur|Titiwangsa, Kuala Lumpur|Kepong, Kuala Lumpur|Sri Petaling, Kuala Lumpur|Desa ParkCity, Kuala Lumpur

# Maps loads results gradually. Increase these if your connection is slow.
MAX_STALLED_SCROLLS=12
SCROLL_WAIT_MS=2000

# Set to false while developing if you want to watch the browser.
HEADLESS=true
