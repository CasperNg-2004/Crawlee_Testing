{
  "name": "kl-google-maps-restaurant-scraper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A Crawlee pipeline for collecting public cafe and drinks data from Google Maps.",
  "scripts": {
    "login": "node --env-file=.env src/login.js",
    "start": "node --env-file=.env src/main.js",
    "scrape:one": "node --env-file=.env src/main.js --one-place",
    "start:safe": "node --env-file=.env src/safe-run.js",
    "resume:safe": "node --env-file=.env src/safe-run.js --resume",
    "start:visible": "cross-env HEADLESS=false node --env-file=.env src/main.js",
    "analyze:photos": "node --env-file=.env src/analyze-photos.js",
    "analyze:photos:resume": "node --env-file=.env src/analyze-photos.js --resume",
    "analyze:photos:evaluate": "node --env-file=.env src/analyze-photos.js --evaluate-only",
    "label:photos": "node --env-file=.env src/label-photos.js",
    "setup:paddleocr": "python -m venv .venv-paddleocr && .venv-paddleocr\\Scripts\\python.exe -m pip install --upgrade pip && .venv-paddleocr\\Scripts\\python.exe -m pip install -r requirements-paddleocr.txt",
    "recon:paddleocr": ".venv-paddleocr\\Scripts\\python.exe src/paddleocr-menu.py",
    "parse:menu-ocr": ".venv-paddleocr\\Scripts\\python.exe src/parse-menu-ocr.py",
    "label:menu-ocr": "node --env-file=.env src/label-menu-ocr-unpaired.js",
    "test:menu-parser": "python -m unittest discover -s test -p test_menu_ocr_parser.py",
    "build:photo-map": ".venv-paddleocr\\Scripts\\python.exe src/build-photo-map.py",
    "match:menus": ".venv-paddleocr\\Scripts\\python.exe src/match-menus.py",
    "export:report": "node src/menu-match-report.js",
    "test:menu-matching": "python -m unittest discover -s test -p test_menu_matching.py && node --test test/menu-match-report.test.js",
    "test:output-paths": "python -m unittest discover -s test -p test_output_paths.py && node --test test/output-paths.test.js",
    "export:photos": "node --env-file=.env src/export-results.js photos",
    "export:excel": "node --env-file=.env src/export-results.js excel",
    "test": "node --test"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "crawlee": "^3.15.0",
    "cross-env": "^10.0.0",
    "exceljs": "^4.4.0",
    "playwright": "^1.55.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
